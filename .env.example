# ---- server ----
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
# Where the JSON database (db.json) is written. Use a named volume in Docker.
DATA_DIR=./server/data
# Any long random string; signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
# Only these email domains can be given accounts.
ALLOWED_EMAIL_DOMAINS=tamhub.com
# Developer-version accounts, created on first start. email:password:role
SEED_USERS=admin@tamhub.com:admin12345:admin,user@tamhub.com:user12345:user

# ---- AI ----
# Your Anthropic API key (console.anthropic.com). Can also be entered from Admin > Developer settings.
ANTHROPIC_API_KEY=
# anthropic = call Claude. mock = walk the pipeline without a model (for UI work).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Models offered per run in the UI (id=label, comma separated).
LLM_MODEL_OPTIONS=claude-sonnet-5-5=Sonnet 5.5 (standard),claude-opus-5-5=Opus 5.5 (complex RFPs)
LLM_EFFORT=medium
# Allow the model to web-search for benchmark prices (extra cost).
LLM_WEB_SEARCH=true
LLM_MAX_WEB_SEARCHES=3

# ---- Google sign-in (OpenID Connect) ----
# Path to the client_secret JSON downloaded from Google Cloud, or set the two values below.
GOOGLE_CLIENT_FILE=./server/data/google-client.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client. In production: https://<domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5183/api/auth/google/callback
# People who get the admin role when they sign in with Google.
ADMIN_EMAILS=a.alomerene@tamhub.com
# Keep the seeded email + password login (developer version). Set to false before release.
AUTH_PASSWORD_LOGIN=true

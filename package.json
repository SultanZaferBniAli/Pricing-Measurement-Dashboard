{
  "name": "tam-pricing-platform",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "TAM Development Company - AI-assisted RFP pricing platform",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "db:seed": "python3 scripts/build_db.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "google-auth-library": "^11.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
